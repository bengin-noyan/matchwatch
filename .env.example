# Yalnızca geliştirme değerleri. .env adıyla kopyala (git'e girmez).
POSTGRES_PORT=5432
POSTGRES_PASSWORD=dev-postgres-pw
MATCHWATCH_OWNER_PASSWORD=dev-owner-pw
MATCHWATCH_APP_PASSWORD=dev-app-pw

DATABASE_URL=postgres://matchwatch_app:dev-app-pw@localhost:5432/matchwatch?sslmode=disable
MIGRATE_DATABASE_URL=postgres://matchwatch_owner:dev-owner-pw@localhost:5432/matchwatch?sslmode=disable
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
HTTP_ADDR=:8080
STORAGE_DIR=./data
# Davet ve şifre sıfırlama e-postaları. "log" yazarsan e-postalar (tek kullanımlık bağlantılarıyla) API loguna düşer:
# yalnızca geliştirme için.
# Canlıda: smtp://user:password@host:587 (STARTTLS), sağlayıcı Türkiye'de olmalı (KVKK). Boş bırakırsan iki özellik de
# kapanır.
MAIL_URL=log
MAIL_FROM=matchwatch <no-reply@matchwatch.local>
APP_BASE_URL=http://127.0.0.1:8080

MATCHWATCH_TEST_DATABASE_URL=postgres://matchwatch_app:dev-app-pw@localhost:5432/matchwatch?sslmode=disable
MATCHWATCH_TEST_MIGRATE_URL=postgres://matchwatch_owner:dev-owner-pw@localhost:5432/matchwatch?sslmode=disable

AI_SERVICE_URL=
AI_SERVICE_TOKEN=dev-only-ai-token-change-me-0123456789
AI_EXTRACT_TIMEOUT=5m
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# TCMB_BASE_URL verilmezse https://www.tcmb.gov.tr/kurlar kullanılır; boş verirsen TCMB kurları kapanır
EXTRACT_DEADLINE_S=270
