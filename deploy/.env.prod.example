# Copy to deploy/.env (git-ignored) on the server and fill in. Generate each secret with: openssl rand -hex 32
DOMAIN=matchwatch.example.com.tr

POSTGRES_PASSWORD=
MATCHWATCH_OWNER_PASSWORD=
MATCHWATCH_APP_PASSWORD=
JWT_SECRET=

# Raw XML and contract PDFs. Must be owned by uid 65532 (the image's nonroot user).
STORAGE_PATH=/srv/matchwatch/storage

# Invites and "Şifremi unuttum" send mail through SMTP with STARTTLS; the provider must be in Türkiye (KVKK).
# Empty MAIL_URL disables both. The links point at https://$DOMAIN.
MAIL_URL=
# MAIL_URL=smtp://user:password@smtp.provider.com.tr:587
MAIL_FROM=matchwatch <no-reply@matchwatch.example.com.tr>

# Only with --profile ai; leave AI_SERVICE_URL empty to run without extraction and suggestions.
AI_SERVICE_URL=
# AI_SERVICE_URL=http://ai:8090
AI_SERVICE_TOKEN=
