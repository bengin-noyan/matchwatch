# Sunucuda deploy/.env adıyla kopyala (git'e girmez) ve doldur. Her gizli değeri şununla üret: openssl rand -hex 32
DOMAIN=matchwatch.example.com.tr

POSTGRES_PASSWORD=
MATCHWATCH_OWNER_PASSWORD=
MATCHWATCH_APP_PASSWORD=
JWT_SECRET=

# Ham XML'ler ve sözleşme PDF'leri. Sahibi uid 65532 olmalı (imajdaki nonroot kullanıcı).
STORAGE_PATH=/srv/matchwatch/storage

# Davetler ve "Şifremi unuttum" e-postayı STARTTLS'li SMTP ile gönderir; sağlayıcı Türkiye'de olmalı (KVKK). MAIL_URL
# boşsa ikisi de kapalı. Bağlantılar https://$DOMAIN adresine gider.
MAIL_URL=
# MAIL_URL=smtp://user:password@smtp.provider.com.tr:587
MAIL_FROM=matchwatch <no-reply@matchwatch.example.com.tr>

# Yalnızca --profile ai ile; çıkarım ve öneriler olmadan çalıştırmak için AI_SERVICE_URL'yi boş bırak.
AI_SERVICE_URL=
# AI_SERVICE_URL=http://ai:8090
AI_SERVICE_TOKEN=
